{
  "name": "lalgeo-maps-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check": "tsc --noEmit && node --test test/*.test.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply lalgeo-maps --local",
    "db:migrate:remote": "wrangler d1 migrations apply lalgeo-maps --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260220.0",
    "typescript": "^5.7.3",
    "wrangler": "^4.47.0"
  }
}
