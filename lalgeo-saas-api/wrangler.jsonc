{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lalgeo-saas-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-25",
  "observability": { "enabled": true },
  "workers_dev": true,
  "routes": [
    { "pattern": "api.lalgeo.com", "custom_domain": true }
  ],
  "vars": {
    "CORS_ALLOWED_ORIGINS": "https://lalgeo.com,https://maps.lalgeo.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lalgeo-business",
      "database_id": "c669cbb7-ab4d-4937-b463-1ea547dc7904"
    }
  ]
}
