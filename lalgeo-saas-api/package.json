{
  "name": "lalgeo-saas-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "verify:maps-local": "node ../lalgeo-maps-api/scripts/verify-local.mjs --worker-directory . --database lalgeo-business --request-hostname api.lalgeo.com",
    "migrate": "wrangler d1 migrations apply lalgeo-business",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260220.0",
    "typescript": "^5.7.3",
    "wrangler": "^4.47.0"
  }
}
